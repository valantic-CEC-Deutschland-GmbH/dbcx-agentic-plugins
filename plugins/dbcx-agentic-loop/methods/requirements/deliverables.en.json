       "field": "index_quality",
       "emphasis": "decision",
       "status": {
        "good": "standard",
        "partial*": "rework",
        "none*": "rebuild",
        "unextractable": "rebuild"
       },
       "width": 18
      },
      {
       "header": "Covers",
       "field": "covers",
       "width": 60,
       "wrap": true
      },
      {
       "header": "Cite as",
       "field": "cite_as",
       "width": 18
      },
      {
       "header": "Type",
       "field": "type",
       "width": 16,
       "emphasis": "support",
       "group": "detail"
      },
      {
       "header": "Date",
       "field": "date",
       "width": 12,
       "emphasis": "support",
       "group": "detail"
      },
      {
       "header": "Origin",
       "field": "origin",
       "width": 26,
       "wrap": true,
       "emphasis": "support",
       "group": "detail"
      },
      {
       "header": "Citable anchors",
       "field": "anchors",
       "numeric": true,
       "width": 10,
       "emphasis": "support",
       "group": "detail"
      },
      {
       "header": "Assessed quality",
       "field": "quality",
       "width": 16,
       "emphasis": "support",
       "group": "detail"
      },
      {
       "header": "File",
       "field": "path",
       "width": 40,
       "wrap": true,
       "emphasis": "support",
       "group": "loc"
      },
      {
       "header": "Revision",
       "field": "revision",
       "width": 9,
       "emphasis": "support",
       "group": "loc"
      },
      {
       "header": "Notes",
       "field": "notes",
       "width": 40,
       "wrap": true,
       "emphasis": "support",
       "group": "detail"
      }
     ]
    },
    {
     "name": "Epics",
     "type": "table",
     "dataset": "epics",
     "row_key": "name",
     "readme": "One row per {unit.noun}: kind, what it covers, which sources carry it, expected number of requirements",
     "columns": [
      {
       "header": "{unit.noun} id",
       "field": "name",
       "width": 20
      },
      {
       "header": "{unit.noun}",
       "field": "title",
       "width": 28
      },
      {
       "header": "Kind",
       "field": "kind",
       "label": true,
       "validation": "$requirements.types",
       "emphasis": "decision",
       "status": {
        "functional": "standard",
        "technical": "rework",
        "nfr": "neutral"
       },
       "width": 15
      },
      {
       "header": "In scope",
       "field": "activation",
       "label": true,
       "emphasis": "decision",
       "status": {
        "active": "standard",
        "out-of-scope": "neutral"
       },
       "width": 14
      },
      {
       "header": "Basis",
       "grundlage": true,
       "width": 27
      },
      {
       "header": "Description",
       "field": "description",
       "width": 60,
       "wrap": true
      },
      {
       "header": "Requirements expected",
       "field": "estimated_requirements",
       "numeric": true,
       "width": 12
      },
      {
       "header": "Sources",
       "field": "sources",
       "evidence": true,
       "sep": ", ",
       "width": 24,
       "wrap": true,
       "emphasis": "support",
       "group": "detail"
      },
      {
       "header": "Sources (count)",
       "field": "n_sources",
       "numeric": true,
       "width": 10,
       "emphasis": "support",
       "group": "detail"
      },
      {
       "header": "Depends on",
       "field": "depends_on",
       "sep": ", ",
       "width": 24,
       "wrap": true,
       "emphasis": "support",
       "group": "detail"
      },
      {
       "header": "Notes",
       "field": "notes",
       "width": 36,
       "wrap": true,
       "emphasis": "support",
       "group": "detail"
      }
     ]
    },
    {
     "name": "Overview",
     "type": "overview",
     "title": "Source base and {unit.noun} structure (formulas over the sheets Sources and {unit.noun_plural})",
     "readme": "Formula-based counts per {unit.noun} kind and per extraction quality",
     "blocks": [
      {
       "type": "matrix",
       "title": "{unit.noun_plural} by kind",
       "row_header": "Kind",
       "row_tokens": "$requirements.types",
       "total_label": "Total",
       "columns": [
        {
         "header": "{unit.noun_plural}",
         "formula": "=COUNTIF({rng:Epics.kind},{row})"
        },
        {
         "header": "In scope",
         "formula": "=COUNTIFS({rng:Epics.kind},{row},{rng:Epics.activation},\"{L:active}\")"
        },
        {
         "header": "Out of scope",
         "formula": "=COUNTIFS({rng:Epics.kind},{row},{rng:Epics.activation},\"{L:out-of-scope}\")"
        },
        {
         "header": "Requirements expected",
         "formula": "=SUMIF({rng:Epics.kind},{row},{rng:Epics.estimated_requirements})"
        },
        {
         "header": "Source references",
         "formula": "=SUMIF({rng:Epics.kind},{row},{rng:Epics.n_sources})"
        }
       ],
       "chart": {
        "column": 1,
        "title": "{unit.noun_plural} by kind"
       }
      },
      {
       "type": "kv",
       "title": "Source base",
       "rows": [
        {
         "label": "Sources indexed",
         "formula": "=COUNTA({rng:Sources.id})"
        },
        {
         "label": "Text extraction good",
         "formula": "=COUNTIF({rng:Sources.index_quality},\"good\")"
        },
        {
         "label": "Text extraction partial",
         "formula": "=COUNTIF({rng:Sources.index_quality},\"partial*\")"
        },
        {
         "label": "No text layer",
         "formula": "=COUNTIF({rng:Sources.index_quality},\"none*\")"
        },
        {
         "label": "Not extractable at all",
         "formula": "=COUNTIF({rng:Sources.index_quality},\"unextractable\")"
        },
        {
         "label": "Citable anchors in total",
         "formula": "=SUM({rng:Sources.anchors})"
        },
        {
         "label": "Indexed but not inventoried",
         "formula": "=COUNTIF({rng:Sources.notes},\"indexed in the corpus*\")"
        },
        {
         "label": "{unit.noun_plural} resting on a single source",
         "formula": "=COUNTIF({rng:Epics.n_sources},1)"
        },
        {
         "label": "{unit.noun_plural} that depend on another {unit.noun}",
         "formula": "=COUNTA({rng:Epics.depends_on})"
        }
       ]
      }
     ]
    },
    {
     "name": "Claims",
     "type": "claims",
     "scopes": "D1",
     "readme": "Every statement of this workbook with its evidence and the two reviewer scores"
    }
   ]
  },
  "D2": {
   "title": "D2 Requirements for the {system.type}",
   "requires": [
    "SET"
   ],
   "purpose": "The requirements for the {system.type}, one row per requirement, each with the passage of the client's own material that carries it: functional, technical and non-functional requirements per {unit.noun}, with priority, release, acceptance hint, the FR/TR cross-check, the gap check against the reference catalogue, the contradictions found between sources and the open points for the client.",
   "sources": "analysis/consolidated/SET.md (the consolidated set), analysis/scopes/*.md (one requirement set per {unit.noun}), analysis/inventory/source_inventory.md, corpus/index.json",
   "extra": "Traceability is the point of this workbook: the sheet Traceability holds one row per requirement AND locator, so every requirement can be followed to the page, slide, paragraph, spreadsheet row or board item that carries it. A requirement whose locator column reads `inferred` was not stated by any source - it is an inference and is marked as one on the sheet Requirements (status).",
   "sheets": [
    {
     "name": "Management_Summary",
     "type": "mgmt",
     "readme": "KPIs (formulas over the detail sheets) and the assessment of the requirement set",
     "kpis": [
      {
       "id": "requirements",
       "label": "Requirements",
       "formula": "=COUNTA({rng:Requirements.req_id})",
       "note": "the complete set for the {system.type} (sheet Requirements)"
      },
      {
       "id": "functional",
       "label": "of which functional",
       "formula": "=COUNTIF({rng:Requirements.type},\"{L:functional}\")",
       "note": "what the business can do with the system"
      },
      {
       "id": "technical",
       "label": "of which technical",
       "formula": "=COUNTIF({rng:Requirements.type},\"{L:technical}\")",
       "note": "interfaces to other systems, platform, data, migration"
      },
      {
       "label": "of which non-functional",
       "formula": "=COUNTIF({rng:Requirements.type},\"{L:nfr}\")",
       "note": "measurable qualities: performance, availability, security, accessibility, operability"
      },
      {
       "label": "Must-have requirements",
       "formula": "=COUNTIF({rng:Requirements.priority},\"{L:must}\")",
       "note": "priority as the sources state it - never assigned by us"
      },
      {
       "label": "Requirements for {x:phase_in_scope}",
       "formula": "=COUNTIF({rng:Requirements.release},\"{x:phase_in_scope}\")",
       "note": "release assignment as far as the sources give one"
      },
      {
       "label": "Traceable to a source",
       "formula": "=IFERROR(TEXT(COUNTIF({rng:Requirements.traced},\"{L:yes}\")/COUNTA({rng:Requirements.req_id}),\"0%\"),\"\")",
       "note": "share of requirements with at least one locator into the client's own material (sheet Traceability)"
      },
      {
       "label": "Resting on inference",
       "formula": "=COUNTIF({rng:Requirements.status},\"{L:inferred}\")",
       "note": "no source states them literally; each one is marked as inferred on the sheet Requirements"
      },
      {
       "label": "Interfaces without a technical requirement",
       "formula": "=COUNTIF({rng:Crosscheck.relation},\"{L:missing-tr}\")",
       "note": "functional requirements that move data across a system boundary with no technical counterpart (sheet Crosscheck)"
      },
      {
       "label": "Catalogue capabilities without a requirement",
       "formula": "=COUNTIF({rng:Catalogue_Gaps.n_covered},0)",
       "note": "entries of the reference catalogue nothing covers yet (sheet Catalogue_Gaps)"
      },
      {
       "label": "Points to settle with the client",
       "formula": "=COUNTIF({rng:Requirements.status},\"{L:question}\")+COUNTA({rng:Contradictions.topic})",
       "note": "requirements that depend on an answer, plus contradictions between two sources (sheet Contradictions)"
      }
     ]
    },
