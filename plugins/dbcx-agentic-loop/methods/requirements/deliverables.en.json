    {
     "name": "Overview",
     "type": "overview",
     "title": "Requirement set at a glance (formulas over the sheets Requirements, Crosscheck, Catalogue_Gaps, Contradictions)",
     "readme": "Matrices by type x priority and by {unit.noun}, plus the traceability share",
     "blocks": [
      {
       "type": "matrix",
       "title": "Requirements by type and priority",
       "row_header": "Type",
       "row_tokens": "$requirements.types",
       "total_label": "Total",
       "columns": [
        {
         "header": "{L:must}",
         "formula": "=COUNTIFS({rng:Requirements.type},{row},{rng:Requirements.priority},\"{L:must}\")"
        },
        {
         "header": "{L:should}",
         "formula": "=COUNTIFS({rng:Requirements.type},{row},{rng:Requirements.priority},\"{L:should}\")"
        },
        {
         "header": "{L:could}",
         "formula": "=COUNTIFS({rng:Requirements.type},{row},{rng:Requirements.priority},\"{L:could}\")"
        },
        {
         "header": "{L:unknown}",
         "formula": "=COUNTIFS({rng:Requirements.type},{row},{rng:Requirements.priority},\"{L:unknown}\")"
        },
        {
         "header": "Requirements",
         "formula": "=COUNTIF({rng:Requirements.type},{row})"
        },
        {
         "header": "Traceable to a source",
         "formula": "=COUNTIFS({rng:Requirements.type},{row},{rng:Requirements.traced},\"{L:yes}\")"
        },
        {
         "header": "Resting on inference",
         "formula": "=COUNTIFS({rng:Requirements.type},{row},{rng:Requirements.status},\"{L:inferred}\")"
        }
       ],
       "chart": {
        "column": 5,
        "title": "Requirements by type"
       }
      },
      {
       "type": "matrix",
       "title": "Requirements by {unit.noun}",
       "row_header": "{unit.noun}",
       "row_values_from": "requirements.epic",
       "total_label": "Total",
       "columns": [
        {
         "header": "Requirements",
         "formula": "=COUNTIF({rng:Requirements.epic},{row})"
        },
        {
         "header": "{L:functional}",
         "formula": "=COUNTIFS({rng:Requirements.epic},{row},{rng:Requirements.type},\"{L:functional}\")"
        },
        {
         "header": "{L:technical}",
         "formula": "=COUNTIFS({rng:Requirements.epic},{row},{rng:Requirements.type},\"{L:technical}\")"
        },
        {
         "header": "{L:nfr}",
         "formula": "=COUNTIFS({rng:Requirements.epic},{row},{rng:Requirements.type},\"{L:nfr}\")"
        },
        {
         "header": "{L:must}",
         "formula": "=COUNTIFS({rng:Requirements.epic},{row},{rng:Requirements.priority},\"{L:must}\")"
        },
        {
         "header": "Traceable to a source",
         "formula": "=COUNTIFS({rng:Requirements.epic},{row},{rng:Requirements.traced},\"{L:yes}\")"
        },
        {
         "header": "Traceability share",
         "formula": "=IFERROR(COUNTIFS({rng:Requirements.epic},{row},{rng:Requirements.traced},\"{L:yes}\")/COUNTIF({rng:Requirements.epic},{row}),\"\")"
        }
       ],
       "chart": {
        "column": 1,
        "title": "Requirements by {unit.noun}"
       }
      },
      {
       "type": "kv",
       "title": "Traceability, cross-check and open points",
       "rows": [
        {
         "label": "Requirements in total",
         "formula": "=COUNTA({rng:Requirements.req_id})"
        },
        {
         "label": "Traceability share (rows with at least one source locator)",
         "formula": "=IFERROR(COUNTIF({rng:Requirements.traced},\"{L:yes}\")/COUNTA({rng:Requirements.req_id}),\"\")"
        },
        {
         "label": "Traceability share (cross-check, computed on the source column)",
         "formula": "=IFERROR((COUNTA({rng:Requirements.req_id})-COUNTIF({rng:Requirements.source_locators},\"inferred\"))/COUNTA({rng:Requirements.req_id}),\"\")"
        },
        {
         "label": "Locators in total",
         "formula": "=COUNTA({rng:Traceability.locator})"
        },
        {
         "label": "Requirements confirmed by a source",
         "formula": "=COUNTIF({rng:Requirements.status},\"{L:confirmed}\")"
        },
        {
         "label": "Requirements resting on inference",
         "formula": "=COUNTIF({rng:Requirements.status},\"{L:inferred}\")"
        },
        {
         "label": "Requirements depending on an open answer",
         "formula": "=COUNTIF({rng:Requirements.status},\"{L:question}\")"
        },
        {
         "label": "Requirements merged from duplicates",
         "formula": "=COUNTA({rng:Requirements.duplicates_of})"
        },
        {
         "label": "Interfaces with a technical requirement",
         "formula": "=COUNTIF({rng:Crosscheck.relation},\"{L:has-tr}\")"
        },
        {
         "label": "Interfaces without a technical requirement",
         "formula": "=COUNTIF({rng:Crosscheck.relation},\"{L:missing-tr}\")"
        },
        {
         "label": "Technical requirements nothing asks for",
         "formula": "=COUNTIF({rng:Crosscheck.relation},\"{L:orphan-tr}\")"
        },
        {
         "label": "Catalogue capabilities without a requirement",
         "formula": "=COUNTIF({rng:Catalogue_Gaps.n_covered},0)"
        },
        {
         "label": "Catalogue gaps to be decided",
         "formula": "=COUNTIF({rng:Catalogue_Gaps.decision},\"{L:question}\")"
        },
        {
         "label": "Catalogue gaps declared out of scope",
         "formula": "=COUNTIF({rng:Catalogue_Gaps.decision},\"{L:out-of-scope}\")"
        },
        {
         "label": "Contradictions between sources",
         "formula": "=COUNTA({rng:Contradictions.topic})"
        }
       ]
      }
     ]
    },
    {
     "name": "Claims",
     "type": "claims",
     "scopes": "scopes_and_set",
     "readme": "Every statement of this workbook with its evidence and the two reviewer scores"
    }
   ]
  }
 }
