  "D2": {
   "title": "D2 Anforderungen an {system.type}",
   "requires": [
    "SET"
   ],
   "purpose": "Die Anforderungen an {system.type}, eine Zeile je Anforderung, jede mit der Stelle im Material des Kunden, die sie trägt: fachliche, technische und nicht-funktionale Anforderungen je {unit.noun}, mit Priorität, Release, Abnahmehinweis, dem Abgleich fachlich gegen technisch, dem Abgleich gegen den Referenzkatalog, den gefundenen Widersprüchen zwischen Quellen und den offenen Punkten für den Kunden.",
   "sources": "analysis/consolidated/SET.md (der konsolidierte Satz), analysis/scopes/*.md (ein Anforderungssatz je {unit.noun}), analysis/inventory/source_inventory.md, corpus/index.json",
   "extra": "Die Nachweisbarkeit ist der Zweck dieser Arbeitsmappe: das Blatt Nachweis führt eine Zeile je Anforderung UND Fundstelle, damit jede Anforderung bis zur Seite, Folie, zum Absatz, zur Tabellenzeile oder zum Board-Element verfolgt werden kann, die sie trägt. Eine Anforderung, deren Fundstelle `inferred` lautet, hat keine Quelle wörtlich genannt - sie ist eine Ableitung und ist auf dem Blatt Anforderungen (Status) als solche gekennzeichnet.",
   "sheets": [
    {
     "name": "Management_Summary",
     "type": "mgmt",
     "readme": "Kennzahlen (Formeln über die Detailblätter) und Einschätzung des Anforderungssatzes",
     "kpis": [
      {
       "label": "Anforderungen",
       "formula": "=COUNTA({rng:Anforderungen.req_id})",
       "note": "der vollständige Satz für {system.type} (Blatt Anforderungen)",
       "id": "requirements"
      },
      {
       "label": "davon fachlich",
       "formula": "=COUNTIF({rng:Anforderungen.type},\"{L:functional}\")",
       "note": "was das Geschäft mit dem System tun kann",
       "id": "functional"
      },
      {
       "label": "davon technisch",
       "formula": "=COUNTIF({rng:Anforderungen.type},\"{L:technical}\")",
       "note": "Schnittstellen zu anderen Systemen, Plattform, Daten, Migration",
       "id": "technical"
      },
      {
       "label": "davon nicht-funktional",
       "formula": "=COUNTIF({rng:Anforderungen.type},\"{L:nfr}\")",
       "note": "messbare Eigenschaften: Leistung, Verfügbarkeit, Sicherheit, Barrierefreiheit, Betreibbarkeit"
      },
      {
       "label": "Muss-Anforderungen",
       "formula": "=COUNTIF({rng:Anforderungen.priority},\"{L:must}\")",
       "note": "Priorität so, wie die Quellen sie nennen - nie von uns vergeben"
      },
      {
       "label": "Anforderungen für {x:phase_in_scope}",
       "formula": "=COUNTIF({rng:Anforderungen.release},\"{x:phase_in_scope}\")",
       "note": "Release-Zuordnung, soweit die Quellen eine nennen"
      },
      {
       "label": "Auf eine Quelle nachweisbar",
       "formula": "=IFERROR(TEXT(COUNTIF({rng:Anforderungen.traced},\"{L:yes}\")/COUNTA({rng:Anforderungen.req_id}),\"0%\"),\"\")",
       "note": "Anteil der Anforderungen mit mindestens einer Fundstelle im Material des Kunden (Blatt Nachweis)"
      },
      {
       "label": "Auf Ableitung beruhend",
       "formula": "=COUNTIF({rng:Anforderungen.status},\"{L:inferred}\")",
       "note": "keine Quelle nennt sie wörtlich; jede ist auf dem Blatt Anforderungen als abgeleitet gekennzeichnet"
      },
      {
       "label": "Schnittstellen ohne technische Anforderung",
       "formula": "=COUNTIF({rng:Abgleich.relation},\"{L:missing-tr}\")",
       "note": "fachliche Anforderungen, die Daten über eine Systemgrenze bewegen, ohne technisches Gegenstück (Blatt Abgleich)"
      },
      {
       "label": "Katalogfähigkeiten ohne Anforderung",
       "formula": "=COUNTIF({rng:Katalog_Luecken.n_covered},0)",
       "note": "Einträge des Referenzkatalogs, die noch nichts abdeckt (Blatt Katalog_Luecken)"
      },
      {
       "label": "Mit dem Kunden zu klärende Punkte",
       "formula": "=COUNTIF({rng:Anforderungen.status},\"{L:question}\")+COUNTA({rng:Widersprueche.topic})",
       "note": "Anforderungen, die von einer Antwort abhängen, dazu Widersprüche zwischen zwei Quellen (Blatt Widersprueche)"
      }
     ]
    },
    {
     "name": "README",
