      }
     ],
     "row_key": "name"
    },
    {
     "name": "Uebersicht",
     "type": "overview",
     "title": "Quellenlage und {unit.noun}-Struktur (Formeln über die Blätter Quellen und {unit.noun_plural})",
     "readme": "Formelbasierte Auswertung je {unit.noun}-Art und je Textqualität",
     "blocks": [
      {
       "type": "matrix",
       "title": "{unit.noun_plural} je Art",
       "row_header": "Art",
       "row_tokens": "$requirements.types",
       "total_label": "Gesamt",
       "columns": [
        {
         "header": "{unit.noun_plural}",
         "formula": "=COUNTIF({rng:Epics.kind},{row})"
        },
        {
         "header": "Im Umfang",
         "formula": "=COUNTIFS({rng:Epics.kind},{row},{rng:Epics.activation},\"{L:active}\")"
        },
        {
         "header": "Ausserhalb des Umfangs",
         "formula": "=COUNTIFS({rng:Epics.kind},{row},{rng:Epics.activation},\"{L:out-of-scope}\")"
        },
        {
         "header": "Erwartete Anforderungen",
         "formula": "=SUMIF({rng:Epics.kind},{row},{rng:Epics.estimated_requirements})"
        },
        {
         "header": "Quellenverweise",
         "formula": "=SUMIF({rng:Epics.kind},{row},{rng:Epics.n_sources})"
        }
       ],
       "chart": {
        "column": 1,
        "title": "{unit.noun_plural} je Art"
       }
      },
      {
       "type": "kv",
       "title": "Quellenlage",
       "rows": [
        {
         "label": "Indexierte Quellen",
         "formula": "=COUNTA({rng:Quellen.id})"
        },
        {
         "label": "Textgewinnung gut",
         "formula": "=COUNTIF({rng:Quellen.index_quality},\"good\")"
        },
        {
         "label": "Textgewinnung teilweise",
         "formula": "=COUNTIF({rng:Quellen.index_quality},\"partial*\")"
        },
        {
         "label": "Keine Textebene",
         "formula": "=COUNTIF({rng:Quellen.index_quality},\"none*\")"
        },
        {
         "label": "Gar kein Text gewinnbar",
         "formula": "=COUNTIF({rng:Quellen.index_quality},\"unextractable\")"
        },
        {
         "label": "Zitierbare Anker gesamt",
         "formula": "=SUM({rng:Quellen.anchors})"
        },
        {
         "label": "Indexiert, aber nicht im Verzeichnis",
         "formula": "=COUNTIF({rng:Quellen.notes},\"indexed in the corpus*\")"
        },
        {
         "label": "{unit.noun_plural} auf nur einer Quelle",
         "formula": "=COUNTIF({rng:Epics.n_sources},1)"
        },
        {
         "label": "{unit.noun_plural} mit Abhängigkeit von einem anderen {unit.noun}",
         "formula": "=COUNTA({rng:Epics.depends_on})"
        }
       ]
      }
     ]
